{
  "rewrites": [
    {
      "source": "/church/:id",
      "destination": "/api/church?id=:id"
    },
    {
      "source": "/sitemap-churches.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/collections",
      "destination": "/api/collection"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api/collection?slug=:slug"
    },
    {
      "source": "/saints",
      "destination": "/api/saint"
    },
    {
      "source": "/saint/:slug",
      "destination": "/api/saint?slug=:slug"
    },
    {
      "source": "/cities",
      "destination": "/api/city"
    },
    {
      "source": "/churches-in/:slug",
      "destination": "/api/city?slug=:slug"
    },
    {
      "source": "/seven-churches",
      "destination": "/api/seven-churches"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|apple-touch-icon\\.png|og-image\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
