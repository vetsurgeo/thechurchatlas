{
  "redirects": [
    {
      "source": "/church/395",
      "destination": "/church/414",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/church/:id",
      "destination": "/api/church?id=:id"
    },
    {
      "source": "/sitemap-churches.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/collections",
      "destination": "/api/collection"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api/collection?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(favicon\\.svg|apple-touch-icon\\.png|og-image\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
