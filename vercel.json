{
  "rewrites": [
    {
      "source": "/church/:id",
      "destination": "/api/church?id=:id"
    },
    {
      "source": "/sitemap-churches.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/collections",
      "destination": "/api/collection"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api/collection?slug=:slug"
    }
  ]
}
